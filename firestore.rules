rules_version = '2';
// Splitskebab's security rules: this is where every permission is enforced (the pages only follow them). Anything without a rule stays
// closed. Keep the bootstrap admin the same as BOOTSTRAP_ADMIN_EMAIL in public/js/config.js, and the allergen ids the same as
// public/js/allergens.js: rules cannot import JS.
//
// People are known by their Firebase sign-in id (uid), never by their email: every document id, member list, meal list, chat id and map
// key below holds uids, so nobody can read someone's email from the data. An email is stored in two places only, each written by its
// owner and checked to be their own sign-in email: users/{uid}.email, read by the admins (accepting the terms allows that), and
// privateProfiles/{uid}.email, read by the people they are connected to, only when they switched "show my email" on.
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in account with a verified email: any Google account (Google always verifies it; ALLOWED_DOMAIN is "" in config.js).
    // Signed in is not having an account: almost everything below also asks allowed().
    function signedIn() {
      return request.auth != null &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true;
    }

    function me() {
      return request.auth.uid;
    }

    // My own sign-in email: only ever compared with what I write about myself, never used as an id.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function adminList() {
      return get(/databases/$(database)/documents/settings/admins).data.get('uids', []);
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/settings/admins) && me() in adminList();
    }

    // The one account that may create the admin list, once (Settings > General, "Become first admin"): recognised by its sign-in email.
    function isBootstrapAdmin() {
      return signedIn() && myEmail() == 'nino.otten@aperam.com';
    }

    // An admin blocked this person (Settings > Users): they get nothing, and cannot register again.
    function notBlocked() {
      return !exists(/databases/$(database)/documents/blocked/$(me()));
    }

    // Has an account and accepted the terms (users/{uid} with a termsVersion: js/terms.js), or is an admin; and is not blocked. Being
    // signed in with Google alone is not enough: registering, with the terms, is a step. Someone with an account from before the terms
    // gets nothing until they accept them (the app asks).
    function acceptedTerms() {
      return exists(/databases/$(database)/documents/users/$(me())) &&
        get(/databases/$(database)/documents/users/$(me())).data.get('termsVersion', 0) >= 1;
    }
    function allowed() {
      return signedIn() && notBlocked() && (acceptedTerms() || isAdmin() || isBootstrapAdmin());
    }

    // Whether someone (by uid) has an account on Splitskebab: only they can be asked to be friends.
    function isInvited(uid) {
      return (exists(/databases/$(database)/documents/users/$(uid)) && !exists(/databases/$(database)/documents/blocked/$(uid))) ||
        (exists(/databases/$(database)/documents/settings/admins) && uid in adminList());
    }

    function isAllergenList(v) {
      return v is list && v.size() <= 14 &&
        v.hasOnly(['gluten', 'crustaceans', 'eggs', 'fish', 'peanuts', 'soy', 'milk', 'nuts', 'celery', 'mustard', 'sesame', 'sulphites', 'lupin', 'molluscs']);
    }

    function optionalString(d, field, max) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= max);
    }

    // A person's public profile: a name of a sane size and a photo that is null, an https address (their Google photo) or a small
    // JPEG/PNG/WebP picture they chose (a data: URL of at most 60,000 characters, about 45 KB: the app shrinks it to a small square).
    function validProfile(d) {
      return optionalString(d, 'displayName', 200) &&
        (!('photoUrl' in d) || d.photoUrl == null || (d.photoUrl is string && (
          (d.photoUrl.size() <= 500 && d.photoUrl.matches('https://.*')) ||
          (d.photoUrl.size() <= 60000 && d.photoUrl.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+')))));
    }

    // A person's private profile: their allergies, a payment link that is empty or an https address (it ends up as a link other people
    // tap), their list of friends (for friends of friends), who may read it (readers: kept by their own app, js/sharing.js) and, only when
    // they chose to show it, their own sign-in email.
    function validPrivateProfile(d) {
      return (!('allergies' in d) || isAllergenList(d.allergies)) &&
        (!('paymentLink' in d) || (d.paymentLink is string && d.paymentLink.size() <= 300 && (d.paymentLink == '' || d.paymentLink.matches('https://[^\\s"<>]+')))) &&
        (!('friends' in d) || (d.friends is list && d.friends.size() <= 500)) &&
        (!('readers' in d) || (d.readers is list && d.readers.size() <= 1500)) &&
        (!('email' in d) || d.email == myEmail());
    }

    // Accepting the terms (js/terms.js): a version, stamped with the server's time, and my own sign-in email for the admins.
    function termsOk(d) {
      return d.termsVersion is int && d.termsVersion >= 1 && d.termsVersion <= 1000 &&
        d.termsAcceptedAt == request.time && d.email == myEmail();
    }

    // The admins (uids): only an admin reads the list (so nobody else learns who the admins are); anyone with access may see that it does
    // not exist yet, which is how the bootstrap account knows it may become the first admin. isAdmin() reads it regardless of this rule.
    match /settings/admins {
      allow read: if allowed() && (resource == null || me() in resource.data.get('uids', []));
      allow create: if isBootstrapAdmin() && !exists(/databases/$(database)/documents/settings/admins) &&
        request.resource.data.keys().hasOnly(['uids']) && request.resource.data.uids == [me()];
      allow update, delete: if isAdmin();
    }

    // An account: { registeredAt, termsVersion, termsAcceptedAt, email, groups }. Anyone signed in with Google may create their own by
    // accepting the terms (unless blocked), and accept a newer version later; groups are the admins'. Each person reads their own (that is
    // how the app knows they registered), an admin anyone's: that is where the admins see an email, and only of people who accepted.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow create: if signedIn() && me() == uid && notBlocked() &&
        request.resource.data.keys().hasOnly(['registeredAt', 'termsVersion', 'termsAcceptedAt', 'email']) &&
        request.resource.data.registeredAt == request.time && termsOk(request.resource.data);
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groups']) &&
          request.resource.data.get('groups', []) is list) ||
        (signedIn() && me() == uid && notBlocked() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['termsVersion', 'termsAcceptedAt', 'email']) &&
          termsOk(request.resource.data));
      allow delete: if isAdmin();
    }

    // Blocked people ({ blockedAt }): only admins write it; each person may read their own, so the app can tell them.
    match /blocked/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow write: if isAdmin();
    }

    match /settings/groups {
      allow read: if allowed();
      allow write: if isAdmin();
    }

    // The public profile: name and photo, readable by everyone with an account (to find people by name). Each person writes their own
    // (js/auth.js at the first sign-in, the profile page); writing it needs no account yet, so someone who signed in without
    // registering shows up in Settings > Users. Allergies, payment link, friends and the email are NOT here: see the private profile.
    match /userProfiles/{uid} {
      allow read: if allowed();
      allow create, update: if signedIn() && me() == uid &&
        request.resource.data.keys().hasOnly(['displayName', 'photoUrl']) && validProfile(request.resource.data);
      allow delete: if isAdmin();
    }

    // The private profile: allergies, payment link, friend list and (when shown) the email. Readable only by the person and the people
    // on its readers list: housemates, people at their meals and their friends, kept up to date by their own app (js/app.js,
    // js/sharing.js profileReaders). A stranger who registers sees names and photos, nothing more. Each person writes only their own.
    match /privateProfiles/{uid} {
      // One profile: mine, or one that lists me as a reader. The list (the app's "every profile that lists me" query) only by the
      // readers condition, which the query's own filter (readers array-contains me) proves: a condition on the document's id cannot
      // be proven for a query, and would make Firestore refuse the whole list.
      allow get: if allowed() && (me() == uid || me() in resource.data.readers);
      allow list: if allowed() && me() in resource.data.readers;
      allow create, update: if allowed() && me() == uid &&
        request.resource.data.keys().hasOnly(['allergies', 'paymentLink', 'friends', 'readers', 'email']) && validPrivateProfile(request.resource.data);
      allow delete: if isAdmin() || (allowed() && me() == uid);
    }
    // Houses and groups. Members see and change them (add or remove someone, rename); the owner stays a member and is the only one who
    // deletes it. Anyone can leave by removing themselves. Admins (the owner always, plus admins: [uid] they or other admins chose)
    // see the analytics; only an admin changes who is an admin.
    function validCircle(d) {
      return d.keys().hasOnly(['name', 'type', 'members', 'owner', 'admins', 'createdAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 60 &&
        d.type in ['house', 'group'] &&
        d.members is list && d.members.size() >= 1 && d.members.size() <= 60 &&
        d.owner is string && d.owner in d.members &&
        (!('admins' in d) || (d.admins is list && d.admins.size() <= 60));
    }

    function isCircleAdmin(d) {
      return d.owner == me() || me() in d.get('admins', []);
    }

    match /circles/{id} {
      allow read: if allowed() && me() in resource.data.members;
      allow create: if allowed() && validCircle(request.resource.data) && request.resource.data.owner == me() &&
        request.resource.data.members == [me()];
      allow update: if allowed() && me() in resource.data.members && validCircle(request.resource.data) &&
        request.resource.data.owner == resource.data.owner && request.resource.data.type == resource.data.type &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (request.resource.data.get('admins', []) == resource.data.get('admins', []) || isCircleAdmin(resource.data));
      allow delete: if allowed() && resource.data.owner == me();
    }

    // Meals. viewers (the circle's members when it was planned, plus anyone added) see and change it: anyone at the table can change
    // who joins, the recipe, the groceries and the cost. The host, the circle and the creation time never change; only the host deletes.
    function validMeal(d) {
      return d.keys().hasOnly(['title', 'date', 'time', 'circleId', 'circleName', 'host', 'viewers', 'participants', 'declined', 'invited',
          'guests', 'rsvp', 'recipe', 'servings', 'have', 'cost', 'costs', 'settled', 'declineReasons', 'createdAt', 'updatedAt']) &&
        (!('costs' in d) || (d.costs is map && d.costs.size() <= 100)) &&
        (!('declineReasons' in d) || (d.declineReasons is map && d.declineReasons.size() <= 100)) &&
        (!('invited' in d) || (d.invited is list && d.invited.size() <= 100)) &&
        d.title is string && d.title.size() <= 80 &&
        d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        d.time is string && (d.time == '' || d.time.matches('[0-9]{2}:[0-9]{2}')) &&
        d.circleId is string && d.circleName is string && d.circleName.size() <= 60 &&
        d.host is string &&
        d.viewers is list && d.viewers.size() <= 100 &&
        d.participants is list && d.participants.size() <= 100 &&
        d.declined is list && d.declined.size() <= 100 &&
        d.guests is list && d.guests.size() <= 30 &&
        d.rsvp is bool &&
        (d.recipe == null || (d.recipe is map && d.recipe.keys().hasOnly(['source', 'id']) && d.recipe.source in ['builtin', 'user'] && d.recipe.id is string && d.recipe.id.size() <= 100)) &&
        (d.servings == null || (d.servings is int && d.servings >= 1 && d.servings <= 50)) &&
        d.have is list && d.have.size() <= 100 &&
        (!('cost' in d) || d.cost == null || (d.cost is map && d.cost.keys().hasOnly(['totalCents', 'paidBy']) && d.cost.totalCents is int &&
          d.cost.totalCents > 0 && d.cost.totalCents <= 10000000 && d.cost.paidBy is string)) &&
        d.settled is list && d.settled.size() <= 130;
    }

    // Costs: everyone who did groceries adds their own amount (costs.{their uid}); nobody changes someone else's. A changed entry
    // is a whole number of cents between 1 and 100,000 euros. The older one-payer cost (cost: { totalCents, paidBy }) only stays as it
    // is, or is retired (null) by its own payer when they write their entry.
    function costsChangeOk(next, prev) {
      let n = next.get('costs', {});
      let p = prev.get('costs', {});
      return n.diff(p).affectedKeys().hasOnly([me()]) &&
        (!(me() in n) || (n[me()] is int && n[me()] > 0 && n[me()] <= 10000000));
    }
    // Why someone is not coming: everyone writes only their own reason (declineReasons.{their uid}), text of at most 200 characters.
    function reasonsChangeOk(next, prev) {
      let n = next.get('declineReasons', {});
      let p = prev.get('declineReasons', {});
      return n.diff(p).affectedKeys().hasOnly([me()]) &&
        (!(me() in n) || (n[me()] is string && n[me()].size() <= 200));
    }
    function legacyCostOk(next, prev) {
      return next.get('cost', null) == prev.get('cost', null) ||
        (next.get('cost', null) == null && prev.cost.paidBy == me());
    }

    match /meals/{id} {
      allow read: if allowed() && me() in resource.data.viewers;
      allow create: if allowed() && validMeal(request.resource.data) && request.resource.data.host == me() &&
        me() in request.resource.data.viewers &&
        request.resource.data.get('costs', {}).size() == 0 && request.resource.data.get('cost', null) == null &&
        me() in get(/databases/$(database)/documents/circles/$(request.resource.data.circleId)).data.members;
      allow update: if allowed() && me() in resource.data.viewers && validMeal(request.resource.data) &&
        me() in request.resource.data.viewers &&
        request.resource.data.host == resource.data.host &&
        request.resource.data.circleId == resource.data.circleId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        costsChangeOk(request.resource.data, resource.data) &&
        reasonsChangeOk(request.resource.data, resource.data) &&
        legacyCostOk(request.resource.data, resource.data);
      allow delete: if allowed() && resource.data.host == me();
    }

    // Devices that get push notifications: the document id is the device's push token (js/push.js), and only its owner reads, writes
    // or deletes it. Sending happens in functions/index.js with the server's rights, so nobody ever lists other people's devices. A
    // device that changes hands (someone else signs in on the same phone) is taken over by its new owner, who has the token.
    match /devices/{token} {
      allow get, delete: if signedIn() && resource.data.owner == me();
      allow create, update: if allowed() && token.size() <= 4096 &&
        request.resource.data.keys().hasOnly(['owner', 'lang', 'types', 'updatedAt']) &&
        request.resource.data.owner == me() && request.resource.data.lang in ['en', 'nl'] &&
        request.resource.data.types is list && request.resource.data.types.size() <= 3 &&
        request.resource.data.types.hasOnly(['messages', 'meals', 'money']) &&
        request.resource.data.updatedAt == request.time;
    }

    // Friendships: one document per pair, its id the two uids sorted and joined by "|" (so there is never a second one). Either
    // person reads it and deletes it (decline, cancel, unfriend); only the one who was asked accepts it, and accepting changes nothing
    // else. Both people must have access to Splitskebab.
    match /friendships/{id} {
      allow read: if allowed() && me() in resource.data.users;
      allow create: if allowed() &&
        request.resource.data.keys().hasOnly(['users', 'requester', 'status', 'createdAt']) &&
        request.resource.data.users is list && request.resource.data.users.size() == 2 &&
        request.resource.data.users[0] is string && request.resource.data.users[1] is string &&
        request.resource.data.users[0] < request.resource.data.users[1] &&
        id == request.resource.data.users[0] + '|' + request.resource.data.users[1] &&
        me() in request.resource.data.users &&
        request.resource.data.requester == me() &&
        request.resource.data.status == 'pending' &&
        isInvited(request.resource.data.users[0]) && isInvited(request.resource.data.users[1]);
      allow update: if allowed() && me() in resource.data.users && me() != resource.data.requester &&
        resource.data.status == 'pending' && request.resource.data.status == 'accepted' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      allow delete: if allowed() && me() in resource.data.users;
    }

    // ---- Messages ----
    // A conversation is between two people (type "direct", id "a|b" with the uids sorted, like friendships: one per pair) or one
    // person's feedback to the app's admins (type "feedback", id "feedback|<uid>", members [that person]; every admin reads and answers
    // it too). A direct conversation can only be started with someone I am connected to: a housemate, someone at one of my meals, or a
    // friend; that is exactly who is on either of our private profiles' readers lists (kept by our own apps). So a stranger who
    // registers cannot message anyone.
    function connectedTo(other) {
      return (exists(/databases/$(database)/documents/privateProfiles/$(other)) &&
          me() in get(/databases/$(database)/documents/privateProfiles/$(other)).data.get('readers', [])) ||
        (exists(/databases/$(database)/documents/privateProfiles/$(me())) &&
          other in get(/databases/$(database)/documents/privateProfiles/$(me())).data.get('readers', []));
    }
    function canSeeConversation(c) {
      return me() in c.members || (c.type == 'feedback' && isAdmin());
    }
    function validLastMessage(d) {
      return !('lastMessage' in d) || d.lastMessage == null ||
        (d.lastMessage is map && d.lastMessage.keys().hasOnly(['text', 'from']) && d.lastMessage.text is string &&
          d.lastMessage.text.size() <= 160 && d.lastMessage.from is string);
    }

    match /conversations/{id} {
      // One conversation by its id: also when it does not exist yet (that is how the app knows to create it; it reveals nothing).
      allow get: if allowed() && (resource == null || canSeeConversation(resource.data));
      allow list: if allowed() && canSeeConversation(resource.data);
      allow create: if allowed() &&
        request.resource.data.keys().hasOnly(['type', 'members', 'lastMessage', 'lastAt', 'readAt', 'createdAt']) &&
        request.resource.data.createdAt == request.time && validLastMessage(request.resource.data) &&
        (
          (request.resource.data.type == 'direct' && request.resource.data.members is list && request.resource.data.members.size() == 2 &&
            request.resource.data.members[0] is string && request.resource.data.members[1] is string &&
            request.resource.data.members[0] < request.resource.data.members[1] &&
            id == request.resource.data.members[0] + '|' + request.resource.data.members[1] &&
            ((request.resource.data.members[0] == me() && connectedTo(request.resource.data.members[1])) ||
              (request.resource.data.members[1] == me() && connectedTo(request.resource.data.members[0])))) ||
          (request.resource.data.type == 'feedback' && request.resource.data.members == [me()] && id == 'feedback|' + me())
        );
      // Sending a message updates the summary (last message, time) and my own "read up to"; nothing else changes, and nobody changes
      // someone else's read time or writes a last message in someone else's name.
      allow update: if allowed() && canSeeConversation(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'readAt']) &&
        validLastMessage(request.resource.data) &&
        request.resource.data.get('readAt', {}).diff(resource.data.get('readAt', {})).affectedKeys().hasOnly([me()]) &&
        (request.resource.data.get('lastMessage', null) == resource.data.get('lastMessage', null) || request.resource.data.lastMessage.from == me());
      allow delete: if false;

      // The messages: whoever sees the conversation reads them and writes new ones in their own name (text of 1 to 2000 characters,
      // stamped with the server's time). Only the writer edits or deletes theirs; anyone in it may change the reactions.
      match /messages/{mid} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(id)).data;
        }
        allow read: if allowed() && canSeeConversation(conversation());
        allow create: if allowed() && canSeeConversation(conversation()) &&
          request.resource.data.keys().hasOnly(['from', 'text', 'at']) && request.resource.data.from == me() &&
          request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
          request.resource.data.at == request.time;
        allow update: if allowed() && canSeeConversation(conversation()) && (
          (resource.data.from == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
            request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']) &&
            request.resource.data.reactions is map && request.resource.data.reactions.size() <= 20));
        allow delete: if allowed() && resource.data.from == me();
      }
    }

    // Users' own recipes: everyone invited reads them, the author writes them.
    function validRecipe(d) {
      return d.keys().hasOnly(['name', 'servings', 'minutes', 'ingredients', 'allergens', 'steps', 'owner', 'createdAt']) &&
        d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        d.servings is int && d.servings >= 1 && d.servings <= 50 &&
        d.minutes is int && d.minutes >= 0 && d.minutes <= 600 &&
        d.ingredients is list && d.ingredients.size() <= 60 &&
        isAllergenList(d.allergens) &&
        d.steps is string && d.steps.size() <= 5000 &&
        d.owner is string;
    }

    match /recipes/{id} {
      allow read: if allowed();
      allow create: if allowed() && validRecipe(request.resource.data) && request.resource.data.owner == me();
      allow update: if allowed() && resource.data.owner == me() && validRecipe(request.resource.data) &&
        request.resource.data.owner == me() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if allowed() && resource.data.owner == me();
    }
  }
}
